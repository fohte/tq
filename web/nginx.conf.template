server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Keep the event stream open and flush each event as soon as it arrives.
    location = /api/events {
        resolver ${NGINX_RESOLVER} valid=30s;
        set $api_backend "${API_BACKEND_URL}";
        proxy_pass $api_backend;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    # Reverse proxy to API backend
    location /api {
        gzip on;
        gzip_types application/json;
        gzip_proxied any;

        resolver ${NGINX_RESOLVER} valid=30s;
        set $api_backend "${API_BACKEND_URL}";
        proxy_pass $api_backend;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA: route all paths to index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # The service worker script's content changes across deploys but its URL
    # never does, unlike the content-hashed filenames under /assets, so it
    # must always be revalidated instead of falling under the immutable
    # asset cache below.
    location = /sw.js {
        add_header Cache-Control "no-cache";
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }
}
