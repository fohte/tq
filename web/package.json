{
  "name": "web",
  "private": true,
  "type": "module",
  "imports": {
    "#*": {
      "types": [
        "./src/*.tsx",
        "./src/*.ts",
        "./src/*"
      ],
      "default": "./src/*"
    },
    "#storybook-config/*": {
      "types": [
        "./.storybook/*.tsx",
        "./.storybook/*.ts",
        "./.storybook/*"
      ],
      "default": "./.storybook/*"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "conc pnpm:test:type pnpm:test:unit pnpm:build",
    "test:type": "tsc --noEmit",
    "test:unit": "vitest run --project=unit",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test:storybook": "vitest run --project=storybook && vitest run --project=storybook-mobile",
    "test:storybook:capture": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "1.3.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fullcalendar/core": "6.1.21",
    "@fullcalendar/daygrid": "6.1.21",
    "@fullcalendar/interaction": "6.1.21",
    "@fullcalendar/react": "6.1.21",
    "@fullcalendar/timegrid": "6.1.21",
    "@milkdown/crepe": "7.19.0",
    "@milkdown/kit": "7.19.0",
    "@milkdown/plugin-upload": "7.19.0",
    "@milkdown/react": "7.19.0",
    "@prosemirror-adapter/react": "0.5.5",
    "@svar-ui/react-gantt": "2.7.1",
    "@tailwindcss/vite": "4.2.2",
    "@tanstack/react-query": "5.91.2",
    "@tanstack/react-router": "1.167.5",
    "api": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hono": "4.12.34",
    "lucide-react": "0.577.0",
    "neverthrow": "8.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.0.8",
    "tailwind-merge": "3.5.0",
    "tailwindcss": "4.2.2",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@fohte/storybook-addon": "0.1.7",
    "@storybook/addon-a11y": "10.4.6",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/addon-vitest": "10.4.6",
    "@storybook/react-vite": "10.4.6",
    "@storycap-testrun/browser": "2.1.1",
    "@tanstack/router-plugin": "1.166.14",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "eslint-plugin-storybook": "10.4.6",
    "jsdom": "29.0.1",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.0",
    "playwright": "1.62.1",
    "reg-publish-s3-plugin": "0.14.4",
    "reg-simple-keygen-plugin": "0.14.2",
    "reg-suit": "0.14.5",
    "storybook": "10.4.6",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.3.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
