{
  "name": "api",
  "private": true,
  "type": "module",
  "exports": {
    "./types": "./src/app.ts",
    "./constants/images": "./src/constants/images.ts",
    "./constants/mention-pattern": "./src/constants/mention-pattern.ts",
    "./lib/app-url": "./src/lib/app-url.ts",
    "./lib/markdown-parser": "./src/lib/markdown-parser.ts",
    "./lib/test-utils": "./src/lib/test-utils.ts",
    "./lib/text-scan": "./src/lib/text-scan.ts",
    "./schemas/agent-session": "./src/schemas/agent-session.ts",
    "./schemas/project": "./src/schemas/project.ts",
    "./schemas/saved-view": "./src/schemas/saved-view.ts",
    "./schemas/task": "./src/schemas/task.ts",
    "./schemas/task-comment": "./src/schemas/task-comment.ts",
    "./schemas/task-page": "./src/schemas/task-page.ts",
    "./search-query-parser": "./src/search-query-parser.ts"
  },
  "imports": {
    "#*": "./src/*.ts"
  },
  "scripts": {
    "dev": "tsx watch --import @fohte/service-kit/otel-register src/index.ts",
    "build": "tsup",
    "start": "node --import @fohte/service-kit/otel-register dist/index.js",
    "test": "conc pnpm:test:type pnpm:test:unit",
    "test:type": "tsc --noEmit",
    "test:unit": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1075.0",
    "@aws-sdk/s3-request-presigner": "3.1075.0",
    "@fohte/service-kit": "0.1.13",
    "@hono/node-server": "1.19.17",
    "@hono/zod-validator": "0.7.6",
    "@milkdown/kit": "7.19.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@opentelemetry/api": "1.9.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.34",
    "neverthrow": "8.2.0",
    "postgres": "3.4.9",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "aws-sdk-client-mock": "4.1.0",
    "drizzle-kit": "0.31.10",
    "tsup": "8.5.1",
    "tsx": "4.23.12"
  }
}
