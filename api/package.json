{
  "name": "api",
  "private": true,
  "type": "module",
  "exports": {
    "./types": "./src/app.ts",
    "./constants/images": "./src/constants/images.ts",
    "./constants/mention-pattern": "./src/constants/mention-pattern.ts",
    "./schemas/task-page": "./src/schemas/task-page.ts"
  },
  "imports": {
    "#*": "./src/*.ts"
  },
  "scripts": {
    "dev": "tsx watch --import @fohte/service-kit/otel-register src/index.ts",
    "build": "tsup",
    "start": "node --import @fohte/service-kit/otel-register dist/index.js",
    "test": "conc pnpm:test:type pnpm:test:unit",
    "test:type": "tsc --noEmit",
    "test:unit": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1075.0",
    "@aws-sdk/s3-request-presigner": "3.1075.0",
    "@fohte/service-kit": "0.1.7",
    "@hono/mcp": "0.3.1",
    "@hono/node-server": "2.0.5",
    "@hono/zod-validator": "0.7.6",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@opentelemetry/api": "1.9.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.34",
    "neverthrow": "8.2.0",
    "postgres": "3.4.9",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "aws-sdk-client-mock": "4.1.0",
    "drizzle-kit": "0.31.10",
    "tsup": "8.5.1",
    "tsx": "4.23.1"
  }
}
