{
  "name": "tq",
  "private": true,
  "workspaces": [
    "web",
    "api",
    "cli",
    "extension",
    "desktop"
  ],
  "packageManager": "pnpm@12.4.2",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "format:eslint": "eslint --fix .",
    "format:prettier": "prettier --write .",
    "format": "conc -m 1 pnpm:format:eslint pnpm:format:prettier",
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter api dev\" \"pnpm --filter web dev\"",
    "test": "pnpm -r run test",
    "install-cli": "pnpm --filter cli run install-cli"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@fohte/eslint-config": "0.5.1",
    "@ninoseki/eslint-plugin-neverthrow": "0.3.1",
    "@shadcn/lint": "0.1.1",
    "@tsconfig/node-lts": "24.0.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.13.5",
    "concurrently": "10.0.5",
    "eslint": "10.10.0",
    "eslint-plugin-storybook": "10.6.0",
    "eslint-plugin-tailwindcss": "4.4.0",
    "knip": "6.36.0",
    "prettier": "3.9.7",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
