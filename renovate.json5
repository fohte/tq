{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>fohte/renovate-config:base.json5',
    'github>fohte/renovate-config:node.json5',
  ],

  customManagers: [
    {
      // start-postgres/action.yml pins postgres inside a `docker run` shell
      // command, which no built-in manager scans (unlike the `services:`
      // image in format.yml or docker-compose.yml's `image:`, both covered
      // by the github-actions/docker-compose managers).
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/actions/start-postgres/action\\.yml$/',
      ],
      matchStrings: ['^\\s+postgres:(?<currentValue>\\S+)\\s*$'],
      depNameTemplate: 'postgres',
      datasourceTemplate: 'docker',
    },
  ],

  packageRules: [
    // PostgreSQL minor/patch releases only contain bug fixes and stay
    // on-disk-format compatible (https://www.postgresql.org/support/versioning/),
    // so automerge them to keep the pinned image from going stale.
    {
      matchDatasources: ['docker'],
      matchPackageNames: ['postgres'],
      matchUpdateTypes: ['minor', 'patch'],
      automerge: true,
    },
  ],
}
